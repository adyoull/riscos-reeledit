diff --git a/src/modules/core/transition_luma.c b/src/modules/core/transition_luma.c
index c8eb438..a40cf21 100644
--- a/src/modules/core/transition_luma.c
+++ b/src/modules/core/transition_luma.c
@@ -189,6 +189,42 @@ static inline int dissolve_yuv422(mlt_frame frame,
     return ret;
 }
 
+/** A dissolve of two opaque yuv420p pictures, plane by plane, with the
+ * yuv422 path's arithmetic. It saves converting both pictures to yuv422 and
+ * the result back when the consumer wants yuv420p (decoded video usually is).
+ *
+ * \return 0 if it was done; non-zero (nothing changed) if a picture isn't
+ * yuv420p, has an alpha channel that isn't opaque, or the sizes differ:
+ * the caller then uses the yuv422 path.
+ */
+
+static int dissolve_yuv420p(mlt_frame frame, mlt_frame that, float weight, int width, int height)
+{
+    mlt_image_format format = mlt_image_yuv420p;
+    int width_src = width, height_src = height;
+    uint8_t *p_dest = NULL, *p_src = NULL;
+
+    if ((width | height) & 1)
+        return 1;
+    if (mlt_frame_get_image(frame, &p_dest, &format, &width, &height, 1) || !p_dest
+        || format != mlt_image_yuv420p)
+        return 1;
+    format = mlt_image_yuv420p;
+    if (mlt_frame_get_image(that, &p_src, &format, &width_src, &height_src, 0) || !p_src
+        || format != mlt_image_yuv420p || width_src != width || height_src != height)
+        return 1;
+    uint8_t *alpha_dst = mlt_frame_get_alpha(frame), *alpha_src = mlt_frame_get_alpha(that);
+    if ((alpha_dst && !is_opaque(alpha_dst, width, height))
+        || (alpha_src && !is_opaque(alpha_src, width, height)))
+        return 1;
+
+    int mix = weight * (1 << 16);
+    int size = width * height + 2 * (width / 2) * (height / 2);
+    for (int i = 0; i < size; i++)
+        p_dest[i] = (p_src[i] * mix + p_dest[i] * ((1 << 16) - mix)) >> 16;
+    return 0;
+}
+
 static int dissolve_slice_rgba32(int id, int index, int count, void *context)
 {
     struct dissolve_slice_context ctx = *((struct dissolve_slice_context *) context);
@@ -1034,7 +1070,10 @@ static int transition_get_image(mlt_frame a_frame,
         mix = (reverse || invert) ? 1 - mix : mix;
         invert = 0;
         // Dissolve the frames using the time offset for mix value
-        if (alpha_over && *format == mlt_image_rgba) {
+        if (*format == mlt_image_yuv420p
+            && !dissolve_yuv420p(a_frame, b_frame, mix, *width, *height)) {
+            ret = 0;
+        } else if (alpha_over && *format == mlt_image_rgba) {
             ret = dissolve_rgba32(a_frame, b_frame, mix, *width, *height, threads);
         } else if (alpha_over && *format == mlt_image_rgba64) {
             ret = dissolve_rgba64(a_frame, b_frame, mix, *width, *height, threads);
