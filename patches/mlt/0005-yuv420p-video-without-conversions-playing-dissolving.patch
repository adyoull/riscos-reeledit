--- a/src/modules/core/producer_colour.c
+++ b/src/modules/core/producer_colour.c
@@ -57,6 +57,25 @@ mlt_producer producer_colour_init(mlt_profile profile,
     return NULL;
 }
 
+/* A colour in video-range Y'CbCr, BT.601 or BT.709 (coefficients x 1024,
+   scaled to 219/255 for Y and 224/255 for Cb and Cr). Made in the
+   profile's colour space, a picture needs no conversion afterwards (HD
+   profiles are BT.709: a BT.601 picture was converted through RGB). */
+static void rgb_to_yuv(int r, int g, int b, int use_709, uint8_t *y, uint8_t *u, uint8_t *v)
+{
+    if (use_709) {
+        *y = ((187 * r + 629 * g + 63 * b) >> 10) + 16;
+        *u = ((-103 * r - 347 * g + 450 * b) >> 10) + 128;
+        *v = ((450 * r - 409 * g - 41 * b) >> 10) + 128;
+    } else {
+        uint8_t yy, uu, vv;
+        RGB2YUV_601_SCALED(r, g, b, yy, uu, vv);
+        *y = yy;
+        *u = uu;
+        *v = vv;
+    }
+}
+
