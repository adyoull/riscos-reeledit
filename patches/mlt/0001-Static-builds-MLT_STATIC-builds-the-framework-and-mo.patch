diff --git a/CMakeLists.txt b/CMakeLists.txt
index 08b550c..249068c 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -55,6 +55,25 @@ option(MOD_VIDSTAB "Enable vid.stab module (GPL)" ON)
 option(MOD_VORBIS "Enable Vorbis module" ON)
 option(MOD_XINE "Enable XINE module (GPL)" ON)
 option(MOD_XML "Enable XML module" ON)
+option(MLT_STATIC "Build the framework and modules as static libraries, with the modules registered at link time instead of loaded with dlopen (for systems without dlopen)" OFF)
+if(MLT_STATIC)
+  set(MLT_LIBRARY_TYPE STATIC)
+  set(MLT_MODULE_TYPE STATIC)
+else()
+  set(MLT_LIBRARY_TYPE SHARED)
+  set(MLT_MODULE_TYPE MODULE)
+endif()
+
+# A module built into a static MLT: its mlt_register is renamed after it, and
+# it is listed so that mlt_static_modules_register() can register it.
+function(mlt_module_static target)
+  if(MLT_STATIC)
+    string(TOUPPER ${target} _upper)
+    string(REGEX REPLACE "^mlt" "" _name ${target})
+    target_compile_definitions(${target} PRIVATE ${_upper}_STATIC_DEFINE mlt_register=mlt_register_${_name})
+    set_property(GLOBAL APPEND PROPERTY MLT_STATIC_MODULES ${_name})
+  endif()
+endfunction()
 
 option(SWIG_CSHARP "Enable SWIG C# bindings" OFF)
 option(SWIG_JAVA "Enable SWIG Java bindings" OFF)
