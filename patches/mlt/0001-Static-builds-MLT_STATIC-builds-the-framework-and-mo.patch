diff --git a/src/modules/CMakeLists.txt b/src/modules/CMakeLists.txt
index afc8709..422dd4e 100644
--- a/src/modules/CMakeLists.txt
+++ b/src/modules/CMakeLists.txt
@@ -115,3 +115,24 @@ endif()
 if(MOD_XML)
   add_subdirectory(xml)
 endif()
+
+# A static MLT: one library that registers every module built into it.
+if(MLT_STATIC)
+  get_property(_mlt_static_modules GLOBAL PROPERTY MLT_STATIC_MODULES)
+  set(_decls "")
+  set(_calls "")
+  set(_targets "")
+  foreach(_m ${_mlt_static_modules})
+    string(APPEND _decls "void mlt_register_${_m}(mlt_repository repository);\n")
+    string(APPEND _calls "    mlt_repository_add_static(\"${_m}\", mlt_register_${_m});\n")
+    list(APPEND _targets mlt${_m})
+  endforeach()
+  file(WRITE ${CMAKE_CURRENT_BINARY_DIR}/mlt_static_modules.c
+    "/* Generated by src/modules/CMakeLists.txt: the modules built into this static MLT. */\n"
+    "#include <framework/mlt_repository.h>\n\n"
+    "${_decls}\n"
+    "void mlt_static_modules_register(void)\n{\n${_calls}}\n")
+  add_library(mlt-static-modules STATIC ${CMAKE_CURRENT_BINARY_DIR}/mlt_static_modules.c)
+  target_link_libraries(mlt-static-modules PUBLIC ${_targets} mlt)
+  install(TARGETS mlt-static-modules ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR})
+endif()
