diff --git a/src/framework/mlt_repository.c b/src/framework/mlt_repository.c
index b82a347..5cad8be 100644
--- a/src/framework/mlt_repository.c
+++ b/src/framework/mlt_repository.c
@@ -27,7 +27,9 @@
 #include "mlt_tokeniser.h"
 
 #include <dirent.h>
+#ifndef MLT_STATIC_DEFINE
 #include <dlfcn.h>
+#endif
 #include <limits.h>
 #include <stdio.h>
 #include <stdlib.h>
@@ -59,13 +61,41 @@ struct mlt_repository_s
  * \return a new repository or NULL if failed
  */
 
-mlt_repository mlt_repository_init(const char *directory)
+#define MLT_STATIC_MAX 32
+static struct
 {
-    // Safety check
-    if (directory == NULL || strcmp(directory, "") == 0)
-        return NULL;
+    const char *name;
+    mlt_repository_callback callback;
+} static_modules[MLT_STATIC_MAX];
+static int static_count = 0;
 
-    // Construct the repository
+/** Add a module built into the program, for a static MLT.
+ *
+ * Every later mlt_repository_init registers the modules added here, in the
+ * order they were added, and doesn't look in its directory.
+ *
+ * \public \memberof mlt_repository_s
+ * \param name the module's name, for messages
+ * \param callback its registration function (its mlt_register, renamed)
+ */
+
+void mlt_repository_add_static(const char *name, mlt_repository_callback callback)
+{
+    int i;
+    for (i = 0; i < static_count; i++)
+        if (static_modules[i].callback == callback)
+            return;
+    if (static_count < MLT_STATIC_MAX) {
+        static_modules[static_count].name = name;
+        static_modules[static_count].callback = callback;
+        static_count++;
+    } else {
+        mlt_log_error(NULL, "%s: too many static modules (%s)\n", __FUNCTION__, name);
+    }
+}
+
+static mlt_repository repository_new(void)
+{
     mlt_repository self = calloc(1, sizeof(struct mlt_repository_s));
     mlt_properties_init(&self->parent, self);
     self->consumers = mlt_properties_new();
@@ -73,6 +103,36 @@ mlt_repository mlt_repository_init(const char *directory)
     self->links = mlt_properties_new();
     self->producers = mlt_properties_new();
     self->transitions = mlt_properties_new();
+    return self;
+}
+
+mlt_repository mlt_repository_init(const char *directory)
+{
+    // Modules built into the program take the place of the directory's
+    if (static_count > 0) {
+        mlt_repository self = repository_new();
+        int i;
+        for (i = 0; i < static_count; i++) {
+            mlt_log_debug(NULL, "%s: registering built-in module %s\n", __FUNCTION__, static_modules[i].name);
+            static_modules[i].callback(self);
+        }
+        return self;
+    }
+
+#ifdef MLT_STATIC_DEFINE
+    mlt_log_error(NULL,
+                  "%s: no modules: a static MLT needs mlt_static_modules_register() "
+                  "before mlt_factory_init()\n",
+                  __FUNCTION__);
+    (void) directory;
+    return NULL;
+#else
+    // Safety check
+    if (directory == NULL || strcmp(directory, "") == 0)
+        return NULL;
+
+    // Construct the repository
+    mlt_repository self = repository_new();
 
     // Get the directory list
     mlt_properties dir = mlt_properties_new();
@@ -198,6 +258,7 @@ mlt_repository mlt_repository_init(const char *directory)
     mlt_tokeniser_close(tokeniser);
 
     return self;
+#endif
 }
 
