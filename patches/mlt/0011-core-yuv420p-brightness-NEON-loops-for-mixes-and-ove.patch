+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+/* Built with -mfpu=neon on 32-bit ARM (CMakeLists.txt); elsewhere each
+   function returns 0. See core_neon.h. */
+
+#include "core_neon.h"
+
+#include <framework/mlt_factory.h>
+#include <stdlib.h>
+#include <string.h>
+
+#if defined(__ARM_NEON) || defined(__ARM_NEON__)
+#include <arm_neon.h>
+
+static int neon = -1;
+
+int mlt_core_neon(void)
+{
+    if (neon < 0) {
+        const char *e = mlt_environment("MLT_NEON");
+        neon = e && atoi(e) > 0;
+    }
+    return neon;
+}
+
+/* 16.16 to 8.8, 0 .. 256 */
+static inline int to8(int32_t v)
+{
+    v = (v + 128) >> 8;
+    return v < 0 ? 0 : v > 256 ? 256 : v;
+}
+
+int mlt_core_neon_mix(uint8_t *d, const uint8_t *s, int n, int32_t mix)
+{
+    if (!mlt_core_neon())
+        return 0;
+    int m = to8(mix), i = 0;
+    if (m == 0)
+        return 1;
+    if (m == 256) {
+        memcpy(d, s, n);
+        return 1;
+    }
+    uint8x8_t vm = vdup_n_u8(m), vi = vdup_n_u8(256 - m);
+    for (; i + 16 <= n; i += 16) {
+        uint8x16_t vs = vld1q_u8(s + i), vd = vld1q_u8(d + i);
+        uint16x8_t lo = vmlal_u8(vmull_u8(vget_low_u8(vs), vm), vget_low_u8(vd), vi);
+        uint16x8_t hi = vmlal_u8(vmull_u8(vget_high_u8(vs), vm), vget_high_u8(vd), vi);
+        vst1q_u8(d + i, vcombine_u8(vshrn_n_u16(lo, 8), vshrn_n_u16(hi, 8)));
+    }
+    for (; i < n; i++)
+        d[i] = (s[i] * m + d[i] * (256 - m)) >> 8;
+    return 1;
+}
+
+int mlt_core_neon_scale(uint8_t *p, int n, int32_t m, int32_t add, int min, int max)
+{
+    /* (as brightness uses it: luma, add 0; chroma, add 128 * (65536 - m); m below 1) */
+    if (!mlt_core_neon() || m < 0 || m >= 65536 - 128 || (add && add != 128 * (65536 - m)))
+        return 0;
+    int m8 = to8(m), i = 0;
+    int a8 = add ? 128 * (256 - m8) : 0; /* (p * m8 + a8: below 65536) */
+    uint8x8_t vm = vdup_n_u8(m8);
+    uint16x8_t va = vdupq_n_u16(a8);
+    uint8x16_t vmin = vdupq_n_u8(min), vmax = vdupq_n_u8(max);
+    for (; i + 16 <= n; i += 16) {
+        uint8x16_t vp = vld1q_u8(p + i);
+        uint16x8_t lo = vaddq_u16(vmull_u8(vget_low_u8(vp), vm), va);
+        uint16x8_t hi = vaddq_u16(vmull_u8(vget_high_u8(vp), vm), va);
+        uint8x16_t r = vcombine_u8(vshrn_n_u16(lo, 8), vshrn_n_u16(hi, 8));
+        vst1q_u8(p + i, vminq_u8(vmaxq_u8(r, vmin), vmax));
+    }
+    for (; i < n; i++) {
+        int v = (p[i] * m8 + a8) >> 8;
+        p[i] = v < min ? min : v > max ? max : v;
+    }
+    return 1;
+}
+
+/* An 8.8 mix from an alpha and the weight (8.8): a + a/128 (0 .. 256: 0
+   stays 0, 255 is 256), times the weight */
+static inline uint16x8_t mix_of(uint16x8_t a, int w, uint16x8_t vw)
+{
+    uint16x8_t m = vaddq_u16(a, vshrq_n_u16(a, 7));
+    return w >= 256 ? m : vshrq_n_u16(vmulq_u16(m, vw), 8);
+}
+
+static inline int mix1(int a, int w)
+{
+    int m = a + (a >> 7);
+    return w >= 256 ? m : (m * w) >> 8;
+}
+
+/* s over d (8 pixels, u16) by an 8.8 mix */
+static inline uint8x8_t over(uint8x8_t s, uint8x8_t d, uint16x8_t m)
+{
+    uint16x8_t v = vmulq_u16(vmovl_u8(s), m);
+    v = vmlaq_u16(v, vmovl_u8(d), vsubq_u16(vdupq_n_u16(256), m));
+    return vshrn_n_u16(v, 8);
+}
+
+int mlt_core_neon_blend(uint8_t *d, const uint8_t *s, const uint8_t *a, int n, int32_t weight)
+{
+    if (!mlt_core_neon() || !a)
+        return 0;
+    int w = to8(weight), i = 0;
+    if (w == 0)
+        return 1;
+    uint16x8_t vw = vdupq_n_u16(w);
+    for (; i + 16 <= n; i += 16) {
+        uint8x16_t va = vld1q_u8(a + i);
+        uint8x16_t vs = vld1q_u8(s + i), vd = vld1q_u8(d + i);
+        uint16x8_t mlo = mix_of(vmovl_u8(vget_low_u8(va)), w, vw);
+        uint16x8_t mhi = mix_of(vmovl_u8(vget_high_u8(va)), w, vw);
+        vst1q_u8(d + i,
+                 vcombine_u8(over(vget_low_u8(vs), vget_low_u8(vd), mlo),
+                             over(vget_high_u8(vs), vget_high_u8(vd), mhi)));
+    }
+    for (; i < n; i++) {
+        int m = mix1(a[i], w);
+        d[i] = (s[i] * m + d[i] * (256 - m)) >> 8;
+    }
+    return 1;
+}
+
+int mlt_core_neon_blend_chroma(uint8_t *du,
+                               uint8_t *dv,
+                               const uint8_t *su,
+                               const uint8_t *sv,
+                               const uint8_t *a0,
+                               const uint8_t *a1,
+                               int n,
+                               int32_t weight)
+{
+    if (!mlt_core_neon() || !a0 || !a1)
+        return 0;
+    int w = to8(weight), i = 0;
+    if (w == 0)
+        return 1;
+    uint16x8_t vw = vdupq_n_u16(w), two = vdupq_n_u16(2);
+    for (; i + 8 <= n; i += 8) {
+        /* (2x2 sums: pairs across each row, then the two rows) */
+        uint16x8_t sum = vaddq_u16(vpaddlq_u8(vld1q_u8(a0 + 2 * i)), vpaddlq_u8(vld1q_u8(a1 + 2 * i)));
+        uint16x8_t al = vshrq_n_u16(vaddq_u16(sum, two), 2);
+        uint16x8_t m = mix_of(al, w, vw);
+        vst1_u8(du + i, over(vld1_u8(su + i), vld1_u8(du + i), m));
+        vst1_u8(dv + i, over(vld1_u8(sv + i), vld1_u8(dv + i), m));
+    }
+    for (; i < n; i++) {
+        int al = (a0[2 * i] + a0[2 * i + 1] + a1[2 * i] + a1[2 * i + 1] + 2) >> 2;
+        int m = mix1(al, w);
+        du[i] = (su[i] * m + du[i] * (256 - m)) >> 8;
+        dv[i] = (sv[i] * m + dv[i] * (256 - m)) >> 8;
+    }
+    return 1;
+}
+
+#else
+
+int mlt_core_neon(void)
+{
+    return 0;
+}
+
+int mlt_core_neon_mix(uint8_t *d, const uint8_t *s, int n, int32_t mix)
+{
+    (void) d, (void) s, (void) n, (void) mix;
+    return 0;
+}
+
+int mlt_core_neon_scale(uint8_t *p, int n, int32_t m, int32_t add, int min, int max)
+{
+    (void) p, (void) n, (void) m, (void) add, (void) min, (void) max;
+    return 0;
+}
+
+int mlt_core_neon_blend(uint8_t *d, const uint8_t *s, const uint8_t *a, int n, int32_t weight)
+{
+    (void) d, (void) s, (void) a, (void) n, (void) weight;
+    return 0;
+}
+
+int mlt_core_neon_blend_chroma(uint8_t *du,
+                               uint8_t *dv,
+                               const uint8_t *su,
+                               const uint8_t *sv,
+                               const uint8_t *a0,
+                               const uint8_t *a1,
+                               int n,
+                               int32_t weight)
+{
+    (void) du, (void) dv, (void) su, (void) sv, (void) a0, (void) a1, (void) n, (void) weight;
+    return 0;
+}
+
+#endif
diff --git a/src/modules/core/core_neon.h b/src/modules/core/core_neon.h
new file mode 100644
index 0000000..9093d1e
--- /dev/null
+++ b/src/modules/core/core_neon.h
@@ -0,0 +1,53 @@
+/*
+ * core_neon.h -- NEON versions of the core module's hottest loops
+ * Copyright (C) 2026 Andrew Youll
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#ifndef CORE_NEON_H
+#define CORE_NEON_H
+
+#include <stdint.h>
+
+/* Each does the whole row with NEON and returns 1, or does nothing and
+   returns 0 (the caller then does it in C): 0 on a build without NEON, and
+   unless the application has said the CPU has it (MLT's environment
+   "MLT_NEON" set to 1, after mlt_factory_init: CPUs without NEON exist,
+   and MLT doesn't detect it). The arithmetic is 8.8 fixed point, so a
+   result can differ by one from the C's 16.16.
+
+   mix:    d = s * mix + d * (1 - mix), mix 16.16 (0 .. 65536)
+   scale:  p = clamp((p * m + add) >> 16, min, max), m 16.16 up to 65536
+           (luma: add 0; chroma towards grey: add 128 * (65536 - m))
+   blend:  d = s over d by each pixel's alpha a, times weight (16.16):
+           see-through pixels (a 0) left as they are, opaque ones (a 255,
+           weight 65536) copied
+   blend_chroma: a 4:2:0 chroma pixel each of u and v, s over d, by the
+           average alpha of its 2x2 luma pixels (rows a0 and a1, 2n wide) */
+int mlt_core_neon(void);
+int mlt_core_neon_mix(uint8_t *d, const uint8_t *s, int n, int32_t mix);
+int mlt_core_neon_scale(uint8_t *p, int n, int32_t m, int32_t add, int min, int max);
+int mlt_core_neon_blend(uint8_t *d, const uint8_t *s, const uint8_t *a, int n, int32_t weight);
+int mlt_core_neon_blend_chroma(uint8_t *du,
+                               uint8_t *dv,
+                               const uint8_t *su,
+                               const uint8_t *sv,
+                               const uint8_t *a0,
+                               const uint8_t *a1,
+                               int n,
+                               int32_t weight);
+
+#endif
