+/* A row of luma scaled towards black, of chroma towards grey (16.16),
+   clamped (core_neon.c has NEON ones, used where the application says
+   there's NEON) */
+static void scale_luma_c(uint8_t *p, int n, int32_t m, int min, int max)
+{
+    for (int i = 0; i < n; i++)
+        p[i] = CLAMP((p[i] * m) >> 16, min, max);
+}
+
+static void scale_chroma_c(uint8_t *p, int n, int32_t m, int32_t add, int min, int max)
+{
+    for (int i = 0; i < n; i++)
+        p[i] = CLAMP((p[i] * m + add) >> 16, min, max);
+}
+
+static void mlt_brightness_scale_luma(uint8_t *p, int n, int32_t m, int min, int max)
+{
+    if (!mlt_core_neon_scale(p, n, m, 0, min, max))
+        scale_luma_c(p, n, m, min, max);
+}
+
+static void mlt_brightness_scale_chroma(uint8_t *p, int n, int32_t m, int32_t add, int min, int max)
+{
+    if (!mlt_core_neon_scale(p, n, m, add, min, max))
+        scale_chroma_c(p, n, m, add, min, max);
+}
+
 static int sliced_proc(int id, int index, int jobs, void *cookie)
 {
     (void) id; // unused
@@ -43,7 +71,27 @@ static int sliced_proc(int id, int index, int jobs, void *cookie)
 
     // Only process if level is something other than 1
     if (ctx->level != 1.0) {
-        if (ctx->image->format == mlt_image_yuv422) {
+        if (ctx->image->format == mlt_image_yuv420p) {
+            /* (each plane as it is: luma towards black, chroma towards grey;
+               a chroma row with the even luma row above it) */
+            int32_t m = ctx->level * (1 << 16);
+            int32_t n = 128 * ((1 << 16) - m);
+            int min = ctx->full_range ? 0 : 16;
+            int max_luma = ctx->full_range ? 255 : 235;
+            int max_chroma = ctx->full_range ? 255 : 240;
+            int cw = (ctx->image->width + 1) / 2;
+            for (int line = 0; line < slice_height; line++) {
+                int y = slice_line_start + line;
+                uint8_t *p = ctx->image->planes[0] + y * ctx->image->strides[0];
+                mlt_brightness_scale_luma(p, ctx->image->width, m, min, max_luma);
+                if (!(y & 1)) {
+                    mlt_brightness_scale_chroma(ctx->image->planes[1] + (y / 2) * ctx->image->strides[1], cw, m, n,
+                                                min, max_chroma);
+                    mlt_brightness_scale_chroma(ctx->image->planes[2] + (y / 2) * ctx->image->strides[2], cw, m, n,
+                                                min, max_chroma);
+                }
+            }
+        } else if (ctx->image->format == mlt_image_yuv422) {
             int32_t m = ctx->level * (1 << 16);
             int32_t n = 128 * ((1 << 16) - m);
             int min = ctx->full_range ? 0 : 16;
@@ -183,11 +231,9 @@ static int filter_get_image(mlt_frame frame,
             *format = mlt_image_rgba;
             break;
         case mlt_image_yuv420p:
-            if (mlt_properties_get_int(properties, "rgb_only")) {
+            if (mlt_properties_get_int(properties, "rgb_only"))
                 *format = mlt_image_rgba;
-            } else {
-                *format = mlt_image_yuv422;
-            }
+            /* (else yuv420p as it is: no conversion to yuv422 and back) */
             break;
         case mlt_image_yuv422p16:
         case mlt_image_yuv420p10:
@@ -201,7 +247,7 @@ static int filter_get_image(mlt_frame frame,
     int error = mlt_frame_get_image(frame, image, format, width, height, 1);
 
     if (*format != mlt_image_rgb && *format != mlt_image_rgba && *format != mlt_image_rgba64
-        && *format != mlt_image_yuv422)
+        && *format != mlt_image_yuv422 && *format != mlt_image_yuv420p)
         level = 1.0;
 
     alpha_level = mlt_properties_exists(properties, "alpha")
