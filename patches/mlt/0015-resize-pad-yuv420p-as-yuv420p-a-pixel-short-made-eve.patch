From 09f7799b62ddc23c41e1db85e6503a55c209925c Mon Sep 17 00:00:00 2001
From: Andrew Youll <andrewyoull86@gmail.com>
Date: Thu, 29 Oct 2026 11:54:24 +0000
Subject: [PATCH 15/16] resize: pad yuv420p as yuv420p, a pixel short made even

A picture that fits the frame with room to spare was converted to yuv422
to be padded, and back again after. A picture in a picture was often a
pixel short of the size asked for, by rounding, so every frame of it was.
Now yuv420p is padded as it is (in the middle, at even offsets, its alpha
too) when the sizes are even, and a size one pixel short is made even (a
pixel's stretch rather than a line of padding). Odd sizes as before.
---
 src/modules/core/filter_resize.c | 79 ++++++++++++++++++++++++++++++--
 1 file changed, 76 insertions(+), 3 deletions(-)

diff --git a/src/modules/core/filter_resize.c b/src/modules/core/filter_resize.c
index 63fca69..d1db8d7 100644
--- a/src/modules/core/filter_resize.c
+++ b/src/modules/core/filter_resize.c
@@ -190,6 +190,53 @@ static uint8_t *frame_resize_image(mlt_frame frame, int owidth, int oheight, mlt
     return input;
 }
 
+/** yuv420p padded (in the middle, at even offsets; its alpha, if it has one,
+	with it): NULL if it can't be (odd sizes, or nothing to do).
+*/
+
+static uint8_t *frame_pad_yuv420p(mlt_frame frame, int owidth, int oheight)
+{
+    mlt_properties properties = MLT_FRAME_PROPERTIES(frame);
+    uint8_t *input = mlt_properties_get_data(properties, "image", NULL);
+    int iwidth = mlt_properties_get_int(properties, "width");
+    int iheight = mlt_properties_get_int(properties, "height");
+    if (!input || iwidth > owidth || iheight > oheight || (iwidth == owidth && iheight == oheight)
+        || (iwidth | iheight | owidth | oheight) & 1 || iwidth <= 0 || iheight <= 0)
+        return NULL;
+    int size = owidth * oheight * 3 / 2;
+    uint8_t *output = mlt_pool_alloc(size);
+    if (!output)
+        return NULL;
+    int ox = ((owidth - iwidth) / 2) & ~1, oy = ((oheight - iheight) / 2) & ~1;
+    memset(output, 16, owidth * oheight);
+    memset(output + owidth * oheight, 128, owidth * oheight / 2);
+    for (int y = 0; y < iheight; y++)
+        memcpy(output + (oy + y) * owidth + ox, input + y * iwidth, iwidth);
+    for (int p = 0; p < 2; p++) {
+        const uint8_t *in = input + iwidth * iheight + p * (iwidth / 2) * (iheight / 2);
+        uint8_t *out = output + owidth * oheight + p * (owidth / 2) * (oheight / 2);
+        for (int y = 0; y < iheight / 2; y++)
+            memcpy(out + (oy / 2 + y) * (owidth / 2) + ox / 2, in + y * (iwidth / 2), iwidth / 2);
+    }
+    int alpha_size = 0;
+    uint8_t *alpha = mlt_frame_get_alpha_size(frame, &alpha_size);
+    uint8_t *alpha_out = NULL;
+    if (alpha && alpha_size >= iwidth * iheight) {
+        alpha_out = mlt_pool_alloc(owidth * oheight);
+        if (!alpha_out) {
+            mlt_pool_release(output);
+            return NULL;
+        }
+        memset(alpha_out, mlt_properties_get_int(properties, "resize_alpha"), owidth * oheight);
+        for (int y = 0; y < iheight; y++)
+            memcpy(alpha_out + (oy + y) * owidth + ox, alpha + y * iwidth, iwidth);
+    }
+    mlt_frame_set_image(frame, output, size, mlt_pool_release);
+    if (alpha_out)
+        mlt_frame_set_alpha(frame, alpha_out, owidth * oheight, mlt_pool_release);
+    return output;
+}
+
 /** Do it :-).
 */
 
@@ -275,9 +322,23 @@ static int filter_get_image(mlt_frame frame,
     mlt_properties_set_int(properties, "resize_width", *width);
     mlt_properties_set_int(properties, "resize_height", *height);
 
-    // If there will be padding, then we need packed image format.
+    // If there will be padding: yuv420p is padded as it is (frame_pad_yuv420p)
+    // when the sizes are even, a size a pixel short made even (a pixel's
+    // stretch, not a line of padding); otherwise packed, as before. (A
+    // picture in a picture was often a pixel short, and was converted to
+    // yuv422 and back for it.)
+    int pad420 = 0;
     if (*format == mlt_image_yuv420p && (owidth < *width || oheight < *height)) {
-        *format = mlt_image_yuv422;
+        if (owidth < *width)
+            owidth += owidth & 1;
+        if (oheight < *height)
+            oheight += oheight & 1;
+        if (owidth < *width || oheight < *height) {
+            if (!((*width | *height | owidth | oheight) & 1))
+                pad420 = 1;
+            else
+                *format = mlt_image_yuv422;
+        }
     }
 
     // Now get the image
@@ -287,7 +348,19 @@ static int filter_get_image(mlt_frame frame,
     }
     error = mlt_frame_get_image(frame, image, format, &owidth, &oheight, writable);
 
-    if (error == 0 && *image && *format != mlt_image_yuv420p) {
+    uint8_t *padded = NULL;
+    if (error == 0 && *image && pad420 && *format == mlt_image_yuv420p
+        && (padded = frame_pad_yuv420p(frame, *width, *height))) {
+        *image = padded;
+    } else if (error == 0 && *image && pad420 && *format == mlt_image_yuv420p) {
+        mlt_image_format yuv422 = mlt_image_yuv422; /* (as before) */
+        if (!mlt_frame_convert_image(frame, image, format, yuv422)) {
+            *image = frame_resize_image(frame, *width, *height, *format);
+        } else {
+            *width = owidth;
+            *height = oheight;
+        }
+    } else if (error == 0 && *image && *format != mlt_image_yuv420p) {
         *image = frame_resize_image(frame, *width, *height, *format);
     } else {
         *width = owidth;
-- 
