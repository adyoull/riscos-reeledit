+ */
+
+#ifndef MKV_INDEX_H
+#define MKV_INDEX_H
+
+#include <libavformat/avformat.h>
+
+/* Before seeking a Matroska file to ts (stream si's time base; si -1:
+   AV_TIME_BASE, the default stream) past the end of what its index holds:
+   a cluster found by reading a little of the file where it should be, some
+   seconds before ts, added to the index, so the demuxer goes straight
+   there instead of reading every cluster from the start. 1 added, 0 not
+   needed (or not Matroska, or none found: the seek as it was). */
+int mlt_mkv_index_for(AVFormatContext *ctx, int si, int64_t ts);
+
+#endif
diff --git a/src/modules/avformat/producer_avformat.c b/src/modules/avformat/producer_avformat.c
index 1e378f9..5ad567f 100644
--- a/src/modules/avformat/producer_avformat.c
+++ b/src/modules/avformat/producer_avformat.c
@@ -27,6 +27,7 @@
 #endif
 
 #include "common.h"
+#include "mkv_index.h"
 
 // MLT Header files
 #include <framework/mlt_cache.h>
@@ -1931,6 +1932,7 @@ static int seek_video(producer_avformat self,
 
             // Seek to the timestamp
             self->video_codec->skip_loop_filter = AVDISCARD_NONREF;
+            mlt_mkv_index_for(context, self->video_index, timestamp); /* (a Matroska file with no Cues) */
             av_seek_frame(context, self->video_index, timestamp, AVSEEK_FLAG_BACKWARD);
 
             // flush any pictures still in decode buffer
@@ -4338,6 +4340,7 @@ static int seek_audio(producer_avformat self, mlt_position position, double time
                 timestamp = 0;
 
             // Set to the real timecode
+            mlt_mkv_index_for(context, -1, timestamp);
             if (av_seek_frame(context, -1, timestamp, AVSEEK_FLAG_BACKWARD) != 0)
                 paused = 1;
 
