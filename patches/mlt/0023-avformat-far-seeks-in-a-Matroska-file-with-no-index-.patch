 src/modules/avformat/mkv_index.c         | 157 +++++++++++++++++++++++
 src/modules/avformat/mkv_index.h         |  33 +++++
 src/modules/avformat/producer_avformat.c |   3 +
 4 files changed, 194 insertions(+)
 create mode 100644 src/modules/avformat/mkv_index.c
 create mode 100644 src/modules/avformat/mkv_index.h

