 src/modules/avformat/common.c             | 15 +++++++
 src/modules/avformat/common.h             |  5 +++
 src/modules/avformat/consumer_avformat.c  | 12 ++++++
 src/modules/avformat/filter_avfilter.c    |  6 ++-
 src/modules/avformat/link_avdeinterlace.c |  1 +
 src/modules/avformat/link_avfilter.c      |  6 ++-
 src/modules/avformat/producer_avformat.c  | 48 ++++++++++++++++++++++-
 src/modules/core/consumer_null.c          |  9 +++++
 9 files changed, 128 insertions(+), 6 deletions(-)

diff --git a/src/melt/melt.c b/src/melt/melt.c
index 23153e6..933665c 100644
--- a/src/melt/melt.c
+++ b/src/melt/melt.c
@@ -735,6 +735,24 @@ static void on_fatal_error(mlt_properties owner, mlt_consumer consumer)
     mlt_properties_set_int(MLT_CONSUMER_PROPERTIES(consumer), "melt_error", 1);
 }
 
+/* A consumer that runs on melt's own thread (mlt_threads_disabled) returns
+   from mlt_consumer_start only when it has finished, so transport() never
+   runs while it works: progress is reported, and a stop requested by a
+   signal is passed on, as each frame is shown. */
+typedef struct
+{
+    mlt_producer producer;
+    int progress, silent, last_position;
+} inline_transport;
+
+static void on_frame_shown(mlt_properties owner, inline_transport *t, mlt_event_data data)
+{
+    (void) data;
+    if (mlt_properties_get_int(MLT_PRODUCER_PROPERTIES(t->producer), "done"))
+        mlt_properties_set_int(owner, "running", 0);
+    report_progress(t->producer, t->progress, &t->last_position, NULL, t->silent);
+}
+
 static void set_preview_scale(mlt_profile *profile, mlt_profile *backup_profile, double scale)
 {
     *backup_profile = mlt_profile_clone(*profile);
@@ -1113,6 +1131,20 @@ int main(int argc, char **argv)
                               consumer,
                               "consumer-fatal-error",
                               (mlt_listener) on_fatal_error);
+            inline_transport inline_t = {melt,
+                                         mlt_properties_get_int(properties, "progress"),
+                                         mlt_properties_get_int(properties, "silent"),
+                                         0};
+            if (mlt_threads_disabled()) {
+                if (!inline_t.progress && !inline_t.silent)
+                    inline_t.progress = 1;
+                mlt_events_listen(properties,
+                                  &inline_t,
+                                  "consumer-frame-show",
+                                  (mlt_listener) on_frame_shown);
+                signal(SIGINT, stop_handler);
+                signal(SIGTERM, stop_handler);
+            }
             if (mlt_consumer_start(consumer) == 0) {
                 // Try to exit gracefully upon these signals
                 signal(SIGINT, stop_handler);
