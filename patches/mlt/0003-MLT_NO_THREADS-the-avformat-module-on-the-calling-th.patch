+            self->packets_inline = mlt_threads_disabled();
+            if (!self->packets_inline)
+                pthread_create(&self->packets_thread, NULL, packets_worker, self);
             self->is_thread_init = 1;
         }
 
@@ -2919,6 +2959,8 @@ static int producer_get_image(mlt_frame frame,
                     av_packet_unref(&self->pkt);
                 av_init_packet(&self->pkt);
                 pthread_mutex_lock(&self->packets_mutex);
+                if (self->packets_inline)
+                    packets_read_inline(self);
                 while (mlt_deque_count(self->vpackets) == 0 && self->packets_thread_ret == 0) {
                     pthread_cond_wait(&self->packets_cond, &self->packets_mutex);
                 }
@@ -3360,6 +3402,7 @@ static int video_codec_init(producer_avformat self, int index, mlt_properties pr
