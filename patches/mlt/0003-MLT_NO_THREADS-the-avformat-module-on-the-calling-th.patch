+
+int mlt_avformat_thread_count(int requested)
+{
+    if (requested <= 0 && mlt_threads_disabled())
+        return 1;
+    return requested;
+}
+
+void mlt_avformat_graph_threads(struct AVFilterGraph *graph)
+{
+    if (graph && mlt_threads_disabled())
+        graph->nb_threads = 1;
+}
