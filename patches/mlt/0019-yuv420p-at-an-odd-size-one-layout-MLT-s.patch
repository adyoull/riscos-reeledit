From b85ca1bc91dfb9e4cea101af30367149b3591fc2 Mon Sep 17 00:00:00 2001
From: Andrew Youll <andrewyoull86@gmail.com>
Date: Thu, 29 Oct 2026 14:21:49 +0000
Subject: [PATCH 19/19] yuv420p at an odd size: one layout, MLT's

MLT lays out yuv420p's chroma w/2 x h/2 (mlt_image_format_planes), FFmpeg
(w+1)/2 x (h+1)/2: at an odd height V starts a chroma row later in
FFmpeg's. Where the two met, V was read from the wrong place or written
over, and FFmpeg's extra row went past the end of MLT's buffer.

- common.c: mlt_avformat_yuv420p_av_to_mlt and _mlt_to_av, the layouts
  copied one to the other.
- filter_avcolour_space: a yuv420p of an odd size in or out is given to
  swscale, and taken from it, in FFmpeg's layout.
- filter_swscale: the same for its input (its output was already copied
  row by row into MLT's); the preview scaler (fast_scale.c) takes odd
  sizes too, plane by plane in MLT's layout.
- producer_avformat: a decoded picture of an odd size is made in FFmpeg's
  layout, then copied into MLT's.
- composite (yuv420p): an odd-sized picture's last row and column take
  the chroma before them, and an odd-height frame's last luma row has
  none drawn.
---
 src/modules/avformat/common.c                | 45 +++++++++++++++
 src/modules/avformat/common.h                | 13 +++++
 src/modules/avformat/filter_avcolour_space.c | 49 ++++++++++++++++-
 src/modules/avformat/filter_swscale.c        | 32 +++++++----
 src/modules/avformat/producer_avformat.c     | 58 ++++++++++++++++----
 src/modules/core/transition_composite.c      | 22 +++++---
 6 files changed, 187 insertions(+), 32 deletions(-)

diff --git a/src/modules/avformat/common.c b/src/modules/avformat/common.c
index 1048953..25c3338 100644
--- a/src/modules/avformat/common.c
+++ b/src/modules/avformat/common.c
@@ -19,9 +19,12 @@
 
 #include "common.h"
 
+#include <string.h>
+
 #include <libavfilter/avfilter.h>
 
 #include <libavutil/channel_layout.h>
+#include <libavutil/mem.h>
 #include <libavutil/pixdesc.h>
 #include <libavutil/samplefmt.h>
 
@@ -749,3 +752,45 @@ void mlt_avformat_yuyv422_to_yuv420p(const uint8_t *src, int src_stride, uint8_t
         }
     }
 }
+
+int mlt_avformat_yuv420p_odd(int width, int height)
+{
+    return ((width | height) & 1) != 0;
+}
+
+void mlt_avformat_yuv420p_av_to_mlt(const uint8_t *av, uint8_t *mlt, int width, int height)
+{
+    int acw = (width + 1) / 2, ach = (height + 1) / 2, mcw = width / 2, mch = height / 2;
+    memcpy(mlt, av, (size_t) width * height);
+    for (int p = 0; p < 2; p++) {
+        const uint8_t *s = av + (size_t) width * height + (size_t) p * acw * ach;
+        uint8_t *d = mlt + (size_t) width * height + (size_t) p * mcw * mch;
+        for (int y = 0; y < mch; y++)
+            memcpy(d + (size_t) y * mcw, s + (size_t) y * acw, mcw);
+    }
+}
+
+uint8_t *mlt_avformat_yuv420p_mlt_to_av(const uint8_t *mlt, int width, int height)
+{
+    int acw = (width + 1) / 2, ach = (height + 1) / 2, mcw = width / 2, mch = height / 2;
+    uint8_t *av = av_malloc((size_t) width * height + 2 * (size_t) acw * ach);
+    if (!av)
+        return NULL;
+    memcpy(av, mlt, (size_t) width * height);
+    for (int p = 0; p < 2; p++) {
+        const uint8_t *s = mlt + (size_t) width * height + (size_t) p * mcw * mch;
+        uint8_t *d = av + (size_t) width * height + (size_t) p * acw * ach;
+        for (int y = 0; y < ach; y++) {
+            int sy = y < mch ? y : mch - 1; /* (the last row again) */
+            uint8_t *row = d + (size_t) y * acw;
+            if (mch > 0 && mcw > 0) {
+                memcpy(row, s + (size_t) sy * mcw, mcw);
+                if (acw > mcw)
+                    row[acw - 1] = row[mcw - 1];
+            } else {
+                memset(row, 128, acw);
+            }
+        }
+    }
+    return av;
+}
diff --git a/src/modules/avformat/common.h b/src/modules/avformat/common.h
index 1019b9d..ad4da44 100644
--- a/src/modules/avformat/common.h
+++ b/src/modules/avformat/common.h
@@ -74,4 +74,17 @@ void mlt_avformat_yuv420p_to_yuyv422(uint8_t *const src[3], const int src_stride
 void mlt_avformat_yuyv422_to_yuv420p(const uint8_t *src, int src_stride, uint8_t *const dst[3],
                                      const int dst_stride[3], int width, int height);
 
+/* yuv420p at an odd width or height: MLT lays out its chroma planes w/2 x
+   h/2 (mlt_image_format_planes: V after U's (w/2) * (h/2)), FFmpeg
+   (w+1)/2 x (h+1)/2, so where V starts, and how big the picture is, differ.
+   At even sizes they're the same and these have nothing to do. */
+/* 1 if they differ at this size */
+int mlt_avformat_yuv420p_odd(int width, int height);
+/* FFmpeg's layout copied into MLT's (the last chroma row and column of an
+   odd size dropped: MLT has none) */
+void mlt_avformat_yuv420p_av_to_mlt(const uint8_t *av, uint8_t *mlt, int width, int height);
+/* MLT's layout copied for FFmpeg to read: a new buffer (av_free it) in
+   FFmpeg's, the last chroma row and column repeated; NULL if none */
+uint8_t *mlt_avformat_yuv420p_mlt_to_av(const uint8_t *mlt, int width, int height);
+
 #endif // COMMON_H
diff --git a/src/modules/avformat/filter_avcolour_space.c b/src/modules/avformat/filter_avcolour_space.c
index 7a16657..6526bfe 100644
--- a/src/modules/avformat/filter_avcolour_space.c
+++ b/src/modules/avformat/filter_avcolour_space.c
@@ -85,7 +85,7 @@ static int convert_mlt_to_av_cs(mlt_image_format format)
 }
 
 // returns set_lumage_transfer result
-static int av_convert_image(uint8_t *out,
+static int av_convert_planes(uint8_t *out,
                             uint8_t *in,
                             int out_fmt,
                             int in_fmt,
@@ -150,6 +150,53 @@ static int av_convert_image(uint8_t *out,
     return error;
 }
 
+/* As av_convert_planes, with a yuv420p of an odd size in or out in MLT's
+   layout (common.h): FFmpeg is given and gives its own */
+static int av_convert_image(uint8_t *out,
+                            uint8_t *in,
+                            int out_fmt,
+                            int in_fmt,
+                            int out_width,
+                            int out_height,
+                            int in_width,
+                            int in_height,
+                            mlt_colorspace src_colorspace,
+                            mlt_colorspace dst_colorspace,
+                            int src_full_range,
+                            int dst_full_range)
+{
+    uint8_t *in_av = NULL, *out_av = NULL;
+    if (in_fmt == AV_PIX_FMT_YUV420P && mlt_avformat_yuv420p_odd(in_width, in_height)) {
+        in_av = mlt_avformat_yuv420p_mlt_to_av(in, in_width, in_height);
+        if (!in_av)
+            return -1;
+    }
+    if (out_fmt == AV_PIX_FMT_YUV420P && mlt_avformat_yuv420p_odd(out_width, out_height)) {
+        out_av = av_malloc(av_image_get_buffer_size(AV_PIX_FMT_YUV420P, out_width, out_height, 1));
+        if (!out_av) {
+            av_free(in_av);
+            return -1;
+        }
+    }
+    int error = av_convert_planes(out_av ? out_av : out,
+                                  in_av ? in_av : in,
+                                  out_fmt,
+                                  in_fmt,
+                                  out_width,
+                                  out_height,
+                                  in_width,
+                                  in_height,
+                                  src_colorspace,
+                                  dst_colorspace,
+                                  src_full_range,
+                                  dst_full_range);
+    if (out_av) /* (an error here is only the colours' settings: the picture was made) */
+        mlt_avformat_yuv420p_av_to_mlt(out_av, out, out_width, out_height);
+    av_free(out_av);
+    av_free(in_av);
+    return error;
+}
+
 /** Do it :-).
 */
 
