+                                          int av_layout)
 {
     mlt_colorspace result = self->yuv_colorspace;
 
@@ -2371,7 +2372,10 @@ static mlt_colorspace convert_image_yuvp(producer_avformat self,
 
     uint8_t *out_data[4];
     int out_stride[4];
-    mlt_image_format_planes(format, width, height, buffer, out_data, out_stride);
+    if (av_layout)
+        av_image_fill_arrays(out_data, out_stride, buffer, AV_PIX_FMT_YUV420P, width, height, 1);
+    else
+        mlt_image_format_planes(format, width, height, buffer, out_data, out_stride);
 
     // Nothing to convert (the same format, colours and range): copy the
     // planes, without making a swscale context and running it each frame
@@ -2420,6 +2424,36 @@ static mlt_colorspace convert_image_yuvp(producer_avformat self,
     return result;
 }
 
+/* As convert_yuvp_planes; yuv420p of an odd size made in FFmpeg's layout
+   and copied into MLT's (common.h): FFmpeg writes more chroma than MLT's
+   layout has room for */
+static mlt_colorspace convert_image_yuvp(producer_avformat self,
+                                         mlt_profile profile,
+                                         AVFrame *frame,
+                                         uint8_t *buffer,
+                                         mlt_image_format format,
+                                         int width,
+                                         int height,
+                                         int src_pix_fmt,
+                                         int dst_pix_fmt,
+                                         int dst_colorspace,
+                                         int dst_full_range)
+{
+    if (format == mlt_image_yuv420p && mlt_avformat_yuv420p_odd(width, height)) {
+        uint8_t *av = av_malloc(av_image_get_buffer_size(AV_PIX_FMT_YUV420P, width, height, 1));
+        if (av) {
+            mlt_colorspace result = convert_yuvp_planes(self, profile, frame, av, format, width, height,
+                                                        src_pix_fmt, dst_pix_fmt, dst_colorspace,
+                                                        dst_full_range, 1);
+            mlt_avformat_yuv420p_av_to_mlt(av, buffer, width, height);
+            av_free(av);
+            return result;
+        }
+    }
+    return convert_yuvp_planes(self, profile, frame, buffer, format, width, height, src_pix_fmt, dst_pix_fmt,
+                               dst_colorspace, dst_full_range, 0);
+}
