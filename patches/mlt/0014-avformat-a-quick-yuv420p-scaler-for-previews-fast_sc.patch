+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#ifndef FAST_SCALE_H
+#define FAST_SCALE_H
+
+#include <stdint.h>
+
+/* A plane scaled from sw x sh to dw x dh (rows sw and dw bytes long):
+   halved (2x2, or along one way, rounding) while it's still twice the size
+   wanted or more, then bilinear in 8-bit fixed point. NEON for the rows
+   (with -mfpu=neon on 32-bit ARM, and only when the application has said
+   the CPU has it: MLT's environment "MLT_NEON" 1). 0, or -1 (no memory). */
+int mlt_fast_scale_plane(const uint8_t *src, int sw, int sh, uint8_t *dst, int dw, int dh);
+
+#endif
diff --git a/src/modules/avformat/filter_swscale.c b/src/modules/avformat/filter_swscale.c
index 25ac5ab..a09db11 100644
--- a/src/modules/avformat/filter_swscale.c
+++ b/src/modules/avformat/filter_swscale.c
@@ -18,6 +18,7 @@
  */
 
 #include "common.h"
+#include "fast_scale.h"
 #include <framework/mlt_factory.h>
 #include <framework/mlt_filter.h>
 #include <framework/mlt_frame.h>
@@ -173,6 +174,39 @@ static int filter_scale(mlt_frame frame,
     if (!mlt_properties_get_int(properties, "consumer.fast_scale"))
         interp |= SWS_FULL_CHR_H_INP | SWS_FULL_CHR_H_INT | SWS_ACCURATE_RND;
 
+    // A preview's yuv420p with nothing to change but the size: scaled here
+    // (fast_scale.h), not by swscale, whose general code was most of the
+    // time a picture in a picture took on a small ARM machine
+    if (*format == mlt_image_yuv420p && mlt_properties_get_int(properties, "consumer.fast_scale")
+        && (interp & 0xff) != SWS_POINT && !(iwidth & 1) && !(iheight & 1) && !(owidth & 1)
+        && !(oheight & 1) && iwidth > 0 && iheight > 0 && owidth > 0 && oheight > 0) {
+        mlt_profile profile = mlt_service_profile(
+            MLT_PRODUCER_SERVICE(mlt_frame_get_original_producer(frame)));
+        mlt_colorspace dst_colorspace = profile ? profile->colorspace : mlt_colorspace_bt601;
+        mlt_colorspace src_colorspace = mlt_image_colorspace_id(mlt_properties_get(properties, "colorspace"));
+        int src_full_range = mlt_properties_get_int(properties, "full_range");
+        int dst_full_range = mlt_image_full_range(mlt_properties_get(properties, "consumer.color_range"));
+        if (src_colorspace == dst_colorspace && src_full_range == dst_full_range) {
+            int out_size = mlt_image_format_size(*format, owidth, oheight, NULL);
+            uint8_t *out = mlt_pool_alloc(out_size);
+            const uint8_t *in = *image;
+            int ok = out && !mlt_fast_scale_plane(in, iwidth, iheight, out, owidth, oheight)
+                     && !mlt_fast_scale_plane(in + iwidth * iheight, iwidth / 2, iheight / 2,
+                                              out + owidth * oheight, owidth / 2, oheight / 2)
+                     && !mlt_fast_scale_plane(in + iwidth * iheight + (iwidth / 2) * (iheight / 2),
+                                              iwidth / 2, iheight / 2,
+                                              out + owidth * oheight + (owidth / 2) * (oheight / 2),
+                                              owidth / 2, oheight / 2);
+            if (ok) {
+                mlt_frame_set_image(frame, out, out_size, mlt_pool_release);
+                *image = out;
+                /* (an alpha: filter_rescale.c scales it) */
+                return 0;
+            }
+            mlt_pool_release(out);
+        }
+    }
+
     // Convert the pixel formats
     int avformat = convert_mlt_to_av_cs(*format);
 
