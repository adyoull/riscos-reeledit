     int preseek = must_decode && self->video_codec->has_b_frames && speed >= 0.0 && speed <= 1.0;
@@ -3056,6 +3094,12 @@ static int producer_get_image(mlt_frame frame,
                                   "decoded video packet with size %d => %d\n",
                                   self->pkt.size,
