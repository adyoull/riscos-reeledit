 /** Initialize the video codec context.
  */
 
+/** The decoder to try first for a codec, from the "prefer" property or else
+ * the MLT_AVFORMAT_PREFER environment variable (or the default chosen when
+ * MLT was built): a comma-separated list of codec=decoder, such as
+ * "h264=h264_vchiq,hevc=hevc_hwdec". An empty value turns it off.
+ *
+ * Such a decoder may refuse a stream it can't take (a hardware decoder,
+ * for a profile or size it doesn't support): when it fails to open, or
+ * fails with ENOSYS or AVERROR_EXTERNAL part way, the clip carries on with
+ * the default decoder.
+ */
+
+/* Preferred decoders open now, in every producer, against
+   MLT_AVFORMAT_PREFER_MAX (0 or unset: no limit). A hardware decoder holds
+   memory the rest of the hardware (an encoder, the display) also needs. */
+static pthread_mutex_t prefer_lock = PTHREAD_MUTEX_INITIALIZER;
+
+/* The producers holding a preferred decoder, which decoder, and when each
+   last decoded a picture (prefer_clock counts every producer's pictures). */
+#define PREFER_HOLDERS 64
+static struct
+{
+    producer_avformat self;
+    const char *name; /* the producer's prefer_name */
+    uint64_t last_used;
+} prefer_holders[PREFER_HOLDERS];
+static uint64_t prefer_clock = 0;
+static int prefer_exit_registered = 0;
+
+/* How many of each preferred decoder may be open at once, in all producers
+   (MLT_AVFORMAT_PREFER_MAX, or the build's default; 0: no limit). On the
+   Raspberry Pi 4 with gpu_mem=128, a second h264_vchiq decoder opens but
+   never gives a picture, and four or more can stop the VideoCore answering:
+   there it is 1. */
+static int prefer_max(void)
+{
+    const char *e = getenv("MLT_AVFORMAT_PREFER_MAX");
+#ifdef MLT_AVFORMAT_PREFER_MAX_DEFAULT
+    if (!e)
+        return MLT_AVFORMAT_PREFER_MAX_DEFAULT;
+#endif
+    return e ? atoi(e) : 0;
+}
+
+/* How many pictures (of any producer) a holder must have gone without
+   decoding before another producer may take its decoder
+   (MLT_AVFORMAT_PREFER_IDLE, default 5). Two clips both in use, as in a
+   dissolve, keep what they have: they don't take the decoder in turns. */
+static int prefer_idle(void)
+{
+    const char *e = getenv("MLT_AVFORMAT_PREFER_IDLE");
+    return e ? atoi(e) : 5;
+}
+
+static int holder_index(producer_avformat self)
+{
+    for (int i = 0; i < PREFER_HOLDERS; i++)
+        if (prefer_holders[i].self == self)
+            return i;
+    return -1;
+}
+
+/* At exit, close every preferred decoder still open: on RISC OS nothing
+   frees a program's VideoCore decoders when it stops, and one left open
+   keeps its memory until the machine is restarted. */
+static void prefer_close_all(void)
+{
+    pthread_mutex_lock(&prefer_lock);
+    for (int i = 0; i < PREFER_HOLDERS; i++) {
+        producer_avformat h = prefer_holders[i].self;
+        if (h) {
+            prefer_holders[i].self = NULL;
+            h->prefer_active = 0;
+            avcodec_free_context(&h->video_codec);
+        }
+    }
+    pthread_mutex_unlock(&prefer_lock);
+}
+
+/** Claim a place for this producer's preferred decoder.
+ *
+ * If every place for that decoder is taken, the least recently used holder
+ * that has been idle long enough (prefer_idle) gives its place up: its
+ * decoder is closed here, before the caller opens the new one (on the Pi,
+ * opening the new one first stalls it until the old one closes), and it
+ * goes back to the default decoder until it can claim a place again.
+ *
+ * \return 1 if the producer now holds a place (the caller opens the
+ * decoder, or gives the place back with free_video_codec if it fails),
+ * 0 if there is none for it now.
+ */
+
+static int prefer_claim(producer_avformat self, const char *name)
+{
+    int max = prefer_max(), idle = prefer_idle(), n = 0, victim = -1, free_slot = -1;
+    pthread_mutex_lock(&prefer_lock);
+    if (!prefer_exit_registered) {
+        prefer_exit_registered = 1;
+        atexit(prefer_close_all);
+    }
+    for (int i = 0; i < PREFER_HOLDERS; i++) {
+        if (!prefer_holders[i].self) {
+            if (free_slot < 0)
+                free_slot = i;
+        } else if (!strcmp(prefer_holders[i].name, name)) {
+            n++;
+            if (prefer_holders[i].self != self
+                && prefer_clock - prefer_holders[i].last_used >= (uint64_t) idle
+                && (victim < 0 || prefer_holders[i].last_used < prefer_holders[victim].last_used))
+                victim = i;
+        }
+    }
+    producer_avformat evicted = NULL;
+    if (max > 0 && n >= max) {
+        // (another thread may be decoding with it: only if it's free now)
+        if (victim < 0 || pthread_mutex_trylock(&prefer_holders[victim].self->video_mutex)) {
+            pthread_mutex_unlock(&prefer_lock);
+            return 0;
+        }
+        evicted = prefer_holders[victim].self;
+        prefer_holders[victim].self = NULL;
+        free_slot = victim;
+    }
+    if (free_slot < 0) {
+        pthread_mutex_unlock(&prefer_lock);
+        return 0;
+    }
+    if (evicted) {
+        // Close the idle holder's decoder first; it reopens the default
+        // decoder when it next needs a picture, and may claim a place again
+        mlt_log_info(MLT_PRODUCER_SERVICE(self->parent),
+                     "decoder %s handed over from %s\n",
+                     name,
+                     mlt_properties_get(MLT_PRODUCER_PROPERTIES(evicted->parent), "resource"));
+        pthread_mutex_lock(&evicted->open_mutex);
+        evicted->prefer_active = 0;
+        avcodec_free_context(&evicted->video_codec);
+        pthread_mutex_unlock(&evicted->open_mutex);
+        evicted->prefer_pending = 1;
+        evicted->last_position = POSITION_INVALID;
+        pthread_mutex_unlock(&evicted->video_mutex);
+    }
+    prefer_holders[free_slot].self = self;
+    prefer_holders[free_slot].name = self->prefer_name;
+    prefer_holders[free_slot].last_used = prefer_clock;
+    pthread_mutex_unlock(&prefer_lock);
+    return 1;
+}
+
+/* A picture is being decoded: the clock moves on, and a holder is in use. */
+static void prefer_touch(producer_avformat self)
+{
+    pthread_mutex_lock(&prefer_lock);
+    prefer_clock++;
+    if (self->prefer_active) {
+        int i = holder_index(self);
+        if (i >= 0)
+            prefer_holders[i].last_used = prefer_clock;
+    }
+    pthread_mutex_unlock(&prefer_lock);
+}
+
+/* Give back a producer's place (it holds one, or has claimed one). */
+static void prefer_give_back(producer_avformat self)
+{
+    pthread_mutex_lock(&prefer_lock);
+    int i = holder_index(self);
+    if (i >= 0)
+        prefer_holders[i].self = NULL;
+    pthread_mutex_unlock(&prefer_lock);
+}
+
+/** Free the video decoder, giving back its place if it was a preferred one. */
+
+static void free_video_codec(producer_avformat self)
+{
+    if (self->video_codec && self->prefer_active) {
+        self->prefer_active = 0;
+        prefer_give_back(self);
+    }
+    avcodec_free_context(&self->video_codec);
+}
+
+static const AVCodec *preferred_decoder_find(producer_avformat self,
+                                             mlt_properties properties,
+                                             enum AVCodecID codec_id,
+                                             int find);
+
+/** Whether a preferred decoder is listed for this codec (and hasn't refused
+ * this clip). Doesn't look the decoder up. */
+
+static int preferred_listed(producer_avformat self, mlt_properties properties, enum AVCodecID codec_id)
+{
+    return preferred_decoder_find(self, properties, codec_id, 0) != NULL;
+}
+/* (preferred_listed and preferred_decoder also keep the name in prefer_name) */
+
+static const AVCodec *preferred_decoder(producer_avformat self,
+                                        mlt_properties properties,
+                                        enum AVCodecID codec_id)
+{
+    return preferred_decoder_find(self, properties, codec_id, 1);
+}
+
+static const AVCodec *preferred_decoder_find(producer_avformat self,
+                                             mlt_properties properties,
+                                             enum AVCodecID codec_id,
+                                             int find)
+{
+    const char *list = mlt_properties_get(properties, "prefer");
+    if (!list)
+        list = getenv("MLT_AVFORMAT_PREFER");
+#ifdef MLT_AVFORMAT_PREFER_DEFAULT
+    if (!list)
+        list = MLT_AVFORMAT_PREFER_DEFAULT;
+#endif
+    if (!list || !*list || self->prefer_refused)
+        return NULL;
+    const char *codec_name = avcodec_get_name(codec_id);
+    size_t codec_len = strlen(codec_name);
+    const char *p = list;
+    while (*p) {
+        const char *end = strchr(p, ',');
+        size_t len = end ? (size_t) (end - p) : strlen(p);
+        if (len > codec_len + 1 && !strncmp(p, codec_name, codec_len) && p[codec_len] == '=') {
+            char name[64];
+            size_t n = len - codec_len - 1;
+            if (n < sizeof(name) && n < sizeof(self->prefer_name)) {
+                memcpy(name, p + codec_len + 1, n);
+                name[n] = 0;
+                memcpy(self->prefer_name, name, n + 1);
+                if (!find)
+                    return (const AVCodec *) 1; /* (listed: only compared with NULL) */
+                const AVCodec *codec = avcodec_find_decoder_by_name(name);
+                if (codec && codec->id == codec_id)
+                    return codec;
+            }
+            return NULL;
+        }
+        if (!end)
+            break;
+        p = end + 1;
+    }
+    return NULL;
+}
+
+/** After the preferred decoder failed part way: the default one instead.
+ *
+ * \return 1 if the default decoder is open (the caller then seeks again to
+ * where it was), 0 if this wasn't the preferred decoder or that error.
+ */
+
+static int prefer_fall_back(producer_avformat self, mlt_properties properties, int error)
+{
+    if (!self->prefer_active || (error != AVERROR(ENOSYS) && error != AVERROR_EXTERNAL))
+        return 0;
+    mlt_log_info(MLT_PRODUCER_SERVICE(self->parent),
+                 "decoder %s failed (%d), using the default\n",
+                 self->video_codec->codec->name,
+                 error);
+    pthread_mutex_lock(&self->open_mutex);
+    free_video_codec(self);
+    pthread_mutex_unlock(&self->open_mutex);
+    self->prefer_refused = 1;
+    self->prefer_pending = 0;
+    if (!video_codec_init(self, self->video_index, properties))
+        return 0;
+    self->last_position = POSITION_INVALID;
+    return 1;
+}
+
 static int video_codec_init(producer_avformat self, int index, mlt_properties properties)
 {
     // Initialise the codec if necessary
@@ -3378,6 +3725,24 @@ static int video_codec_init(producer_avformat self, int index, mlt_properties pr
             if (!(codec = avcodec_find_decoder_by_name("libvpx")))
                 codec = avcodec_find_decoder(codec_params->codec_id);
         }
+        self->prefer_active = 0;
+        if (!mlt_properties_get(properties, "vcodec")) {
+            // The preferred decoder is opened only when the first picture is
+            // decoded (prefer_now, from producer_get_image): opening a
+            // project opens every clip's decoder, and hardware decoders
+            // would hold their memory before any were used
+            if (!self->prefer_now) {
+                self->prefer_pending = preferred_listed(self, properties, codec_params->codec_id);
+            } else {
+                // (producer_get_image has claimed a place for it)
+                if (self->prefer_codec && self->prefer_codec->id == codec_params->codec_id) {
+                    codec = self->prefer_codec;
+                    self->prefer_active = 1;
+                }
+            }
+        }
+
+    retry_open:;
 
         // Setup the codec context
         AVCodecContext *codec_context = avcodec_alloc_context3(codec);
@@ -3476,6 +3841,19 @@ static int video_codec_init(producer_avformat self, int index, mlt_properties pr
             }
             // Now store the codec with its destructor
             self->video_codec = codec_context;
+        } else if (self->prefer_active) {
+            // The preferred decoder refused: the default one instead
+            mlt_log_info(MLT_PRODUCER_SERVICE(self->parent),
+                         "decoder %s refused the video, using the default\n",
+                         codec->name);
+            pthread_mutex_unlock(&self->open_mutex);
+            avcodec_free_context(&codec_context);
+            self->prefer_active = 0;
+            prefer_give_back(self);
+            self->prefer_refused = 1;
+            self->prefer_pending = 0;
+            codec = avcodec_find_decoder(codec_params->codec_id);
+            goto retry_open;
         } else {
             // Remember that we can't use this later
             self->video_index = -1;
@@ -3483,6 +3861,11 @@ static int video_codec_init(producer_avformat self, int index, mlt_properties pr
             return 0;
         }
         pthread_mutex_unlock(&self->open_mutex);
+        mlt_properties_set(properties, "meta.media.decoder", codec->name);
+        mlt_log_info(MLT_PRODUCER_SERVICE(self->parent),
+                     "video decoder %s%s\n",
+                     codec->name,
+                     self->prefer_active ? " (preferred)" : "");
 
         // Process properties as AVOptions
         apply_properties(codec_context,
@@ -3641,7 +4024,7 @@ static void producer_set_up_video(producer_avformat self, mlt_frame frame)
         self->video_index = index;
         mlt_properties_set_int(properties, "_probe_complete", 0);
