From f5b54f5bf999d7f89aeaa718bfeac06aa1d4768a Mon Sep 17 00:00:00 2001
From: Andrew Youll <andrewyoull86@gmail.com>
Date: Tue, 20 Oct 2026 16:34:57 +0100
Subject: [PATCH 4/4] avformat producer: preferred decoders, falling back to
 the default, and drop_before after a jump

The prefer property (or MLT_AVFORMAT_PREFER, or a default chosen at build
time with MLT_AVFORMAT_PREFER_DEFAULT) lists decoders to try first, as
codec=decoder pairs: on RISC OS, h264=h264_vchiq,hevc=hevc_hwdec, the
Raspberry Pi's hardware decoders. Such a decoder refuses streams it
can't take. When it fails to open, the default decoder is opened
instead; when it fails part way (ENOSYS or AVERROR_EXTERNAL), the
default decoder is opened and the producer seeks again to where it was.
meta.media.decoder names the decoder in use.

After a seek, or a jump forward that is decoded through, a preferred
decoder is given drop_before (an option of
the RISC OS hardware decoders; others ignore it), so the pictures before
the one asked for are left out instead of handed over to be thrown away.
---
 src/modules/avformat/CMakeLists.txt        |   5 +
 src/modules/avformat/producer_avformat.c   | 128 +++++++++++++++++++++
 src/modules/avformat/producer_avformat.yml |  16 +++
 3 files changed, 149 insertions(+)

diff --git a/src/modules/avformat/CMakeLists.txt b/src/modules/avformat/CMakeLists.txt
index 8b1bf6c..1eca7f7 100644
--- a/src/modules/avformat/CMakeLists.txt
+++ b/src/modules/avformat/CMakeLists.txt
@@ -29,6 +29,11 @@ add_custom_target(Other_avformat_Files SOURCES
 include(GenerateExportHeader)
 generate_export_header(mltavformat)
 mlt_module_static(mltavformat)
+
+set(MLT_AVFORMAT_PREFER_DEFAULT "" CACHE STRING "Decoders the avformat producer tries first, as codec=decoder,... (for example h264=h264_vchiq); the MLT_AVFORMAT_PREFER environment variable and the prefer property override it")
+if(MLT_AVFORMAT_PREFER_DEFAULT)
+  target_compile_definitions(mltavformat PRIVATE MLT_AVFORMAT_PREFER_DEFAULT="${MLT_AVFORMAT_PREFER_DEFAULT}")
+endif()
 target_compile_options(mltavformat PRIVATE ${MLT_COMPILE_OPTIONS})
 
 target_include_directories(mltavformat SYSTEM PRIVATE ${FFMPEG_INCLUDE_DIRS})
diff --git a/src/modules/avformat/producer_avformat.c b/src/modules/avformat/producer_avformat.c
index 62aaaeb..8df52dc 100644
--- a/src/modules/avformat/producer_avformat.c
+++ b/src/modules/avformat/producer_avformat.c
@@ -129,6 +129,8 @@ struct producer_avformat_s
     int packets_thread_stop; // non-zero when packets_thread is to stop
     int is_thread_init;
     int packets_inline; // no packets_thread: packets are read as they're needed (mlt_threads_disabled)
+    int prefer_active;  // the video decoder is the one asked for by "prefer" (a hardware decoder, say)
+    int prefer_refused; // that decoder refused this clip: use the default from now on
     AVRational video_time_base;
     mlt_frame last_good_frame; // for video error concealment
     int last_good_position;    // for video error concealment
@@ -166,6 +168,7 @@ static void producer_set_up_video(producer_avformat self, mlt_frame frame);
 static void producer_set_up_audio(producer_avformat self, mlt_frame frame);
 static void apply_properties(void *obj, mlt_properties properties, int flags);
 static int video_codec_init(producer_avformat self, int index, mlt_properties properties);
+static int prefer_fall_back(producer_avformat self, mlt_properties properties, int error);
 static void get_audio_streams_info(producer_avformat self);
 static mlt_audio_format pick_audio_format(int sample_fmt);
 static int pick_av_pixel_format(int *pix_fmt, int full_range);
@@ -1927,6 +1930,19 @@ static int seek_video(producer_avformat self,
             self->last_position = POSITION_INVALID;
             av_frame_unref(self->video_frame);
         }
+
+        // After a seek, or a jump forward decoded through, a preferred (hardware)
+        // decoder can leave out the pictures before the one asked for, instead
+        // of handing each over to be thrown away
+        if (!paused && self->prefer_active && av_q2d(self->video_time_base) > 0 && source_fps > 0) {
+            double frame = 1.0 / (av_q2d(self->video_time_base) * source_fps);
+            int64_t target = llrint((req_position - 0.5) * frame);
+            if (self->first_pts != AV_NOPTS_VALUE)
+                target += self->first_pts;
+            else if (context->start_time != AV_NOPTS_VALUE)
+                target += context->start_time; // (as the positions of decoded pictures are worked out)
+            av_opt_set_int(self->video_codec, "drop_before", target, AV_OPT_SEARCH_CHILDREN);
+        }
     }
     pthread_mutex_unlock(&self->packets_mutex);
     return paused;
@@ -3056,6 +3072,12 @@ static int producer_get_image(mlt_frame frame,
                                   "decoded video packet with size %d => %d\n",
                                   self->pkt.size,
                                   self->video_send_result);
+                    if (prefer_fall_back(self, properties, self->video_send_result)) {
+                        seek_video(self, position, req_position, preseek);
+                        self->video_send_result = 0;
+                        decode_errors = 0;
+                        continue;
+                    }
                     // Note: decode may fail at the beginning of MPEGfile (B-frames referencing before first I-frame), so allow a few errors.
                     if (!ignore_send_packet_result(self->video_send_result)) {
                         mlt_log_warning(MLT_PRODUCER_SERVICE(producer),
@@ -3063,6 +3085,12 @@ static int producer_get_image(mlt_frame frame,
                                         self->video_send_result);
                     } else {
                         int error = avcodec_receive_frame(self->video_codec, self->video_frame);
+                        if (error < 0 && prefer_fall_back(self, properties, error)) {
+                            seek_video(self, position, req_position, preseek);
+                            self->video_send_result = 0;
+                            decode_errors = 0;
+                            continue;
+                        }
                         if (error < 0) {
                             if (error != AVERROR(EAGAIN) && ++decode_errors > 10) {
                                 mlt_log_warning(MLT_PRODUCER_SERVICE(producer),
@@ -3356,6 +3384,80 @@ static void apply_properties(void *obj, mlt_properties properties, int flags)
 /** Initialize the video codec context.
  */
 
+/** The decoder to try first for a codec, from the "prefer" property or else
+ * the MLT_AVFORMAT_PREFER environment variable (or the default chosen when
+ * MLT was built): a comma-separated list of codec=decoder, such as
+ * "h264=h264_vchiq,hevc=hevc_hwdec". An empty value turns it off.
+ *
+ * Such a decoder may refuse a stream it can't take (a hardware decoder,
+ * for a profile or size it doesn't support): when it fails to open, or
+ * fails with ENOSYS or AVERROR_EXTERNAL part way, the clip carries on with
+ * the default decoder.
+ */
+
+static const AVCodec *preferred_decoder(producer_avformat self,
+                                        mlt_properties properties,
+                                        enum AVCodecID codec_id)
+{
+    const char *list = mlt_properties_get(properties, "prefer");
+    if (!list)
+        list = getenv("MLT_AVFORMAT_PREFER");
+#ifdef MLT_AVFORMAT_PREFER_DEFAULT
+    if (!list)
+        list = MLT_AVFORMAT_PREFER_DEFAULT;
+#endif
+    if (!list || !*list || self->prefer_refused)
+        return NULL;
+    const char *codec_name = avcodec_get_name(codec_id);
+    size_t codec_len = strlen(codec_name);
+    const char *p = list;
+    while (*p) {
+        const char *end = strchr(p, ',');
+        size_t len = end ? (size_t) (end - p) : strlen(p);
+        if (len > codec_len + 1 && !strncmp(p, codec_name, codec_len) && p[codec_len] == '=') {
+            char name[64];
+            size_t n = len - codec_len - 1;
+            if (n < sizeof(name)) {
+                memcpy(name, p + codec_len + 1, n);
+                name[n] = 0;
+                const AVCodec *codec = avcodec_find_decoder_by_name(name);
+                if (codec && codec->id == codec_id)
+                    return codec;
+            }
+            return NULL;
+        }
+        if (!end)
+            break;
+        p = end + 1;
+    }
+    return NULL;
+}
+
+/** After the preferred decoder failed part way: the default one instead.
+ *
+ * \return 1 if the default decoder is open (the caller then seeks again to
+ * where it was), 0 if this wasn't the preferred decoder or that error.
+ */
+
+static int prefer_fall_back(producer_avformat self, mlt_properties properties, int error)
+{
+    if (!self->prefer_active || (error != AVERROR(ENOSYS) && error != AVERROR_EXTERNAL))
+        return 0;
+    mlt_log_info(MLT_PRODUCER_SERVICE(self->parent),
+                 "decoder %s failed (%d), using the default\n",
+                 self->video_codec->codec->name,
+                 error);
+    pthread_mutex_lock(&self->open_mutex);
+    avcodec_free_context(&self->video_codec);
+    pthread_mutex_unlock(&self->open_mutex);
+    self->prefer_active = 0;
+    self->prefer_refused = 1;
+    if (!video_codec_init(self, self->video_index, properties))
+        return 0;
+    self->last_position = POSITION_INVALID;
+    return 1;
+}
+
 static int video_codec_init(producer_avformat self, int index, mlt_properties properties)
 {
     // Initialise the codec if necessary
@@ -3378,6 +3480,16 @@ static int video_codec_init(producer_avformat self, int index, mlt_properties pr
             if (!(codec = avcodec_find_decoder_by_name("libvpx")))
                 codec = avcodec_find_decoder(codec_params->codec_id);
         }
+        self->prefer_active = 0;
+        if (!mlt_properties_get(properties, "vcodec")) {
+            const AVCodec *preferred = preferred_decoder(self, properties, codec_params->codec_id);
+            if (preferred) {
+                codec = preferred;
+                self->prefer_active = 1;
+            }
+        }
+
+    retry_open:;
 
         // Setup the codec context
         AVCodecContext *codec_context = avcodec_alloc_context3(codec);
@@ -3476,6 +3588,17 @@ static int video_codec_init(producer_avformat self, int index, mlt_properties pr
             }
             // Now store the codec with its destructor
             self->video_codec = codec_context;
+        } else if (self->prefer_active) {
+            // The preferred decoder refused: the default one instead
+            mlt_log_info(MLT_PRODUCER_SERVICE(self->parent),
+                         "decoder %s refused the video, using the default\n",
+                         codec->name);
+            pthread_mutex_unlock(&self->open_mutex);
+            avcodec_free_context(&codec_context);
+            self->prefer_active = 0;
+            self->prefer_refused = 1;
+            codec = avcodec_find_decoder(codec_params->codec_id);
+            goto retry_open;
         } else {
             // Remember that we can't use this later
             self->video_index = -1;
@@ -3483,6 +3606,11 @@ static int video_codec_init(producer_avformat self, int index, mlt_properties pr
             return 0;
         }
         pthread_mutex_unlock(&self->open_mutex);
+        mlt_properties_set(properties, "meta.media.decoder", codec->name);
+        mlt_log_info(MLT_PRODUCER_SERVICE(self->parent),
+                     "video decoder %s%s\n",
+                     codec->name,
+                     self->prefer_active ? " (preferred)" : "");
 
         // Process properties as AVOptions
         apply_properties(codec_context,
diff --git a/src/modules/avformat/producer_avformat.yml b/src/modules/avformat/producer_avformat.yml
index e2c84b7..fc6e792 100644
--- a/src/modules/avformat/producer_avformat.yml
+++ b/src/modules/avformat/producer_avformat.yml
@@ -307,3 +307,19 @@ parameters:
     title: LUT File
     type: string
     description: Path to a LUT file applied to the resource using the ffmpeg lut3d filter.
+
+  - identifier: prefer
+    title: Preferred decoders
+    type: string
+    description: >
+      Decoders to try first, as codec=decoder pairs separated by commas (for
+      example h264=h264_vchiq,hevc=hevc_hwdec). A decoder that refuses the
+      clip, when it opens or part way through, is replaced by the default
+      one. An empty value turns this off. When not set, the
+      MLT_AVFORMAT_PREFER environment variable is used.
+
+  - identifier: meta.media.decoder
+    title: Decoder
+    type: string
+    readonly: yes
+    description: The name of the video decoder in use.
-- 
