+
+set(MLT_AVFORMAT_PREFER_DEFAULT "" CACHE STRING "Decoders the avformat producer tries first, as codec=decoder,... (for example h264=h264_vchiq); the MLT_AVFORMAT_PREFER environment variable and the prefer property override it")
+if(MLT_AVFORMAT_PREFER_DEFAULT)
+  target_compile_definitions(mltavformat PRIVATE MLT_AVFORMAT_PREFER_DEFAULT="${MLT_AVFORMAT_PREFER_DEFAULT}")
+endif()
+set(MLT_AVFORMAT_PREFER_MAX_DEFAULT "" CACHE STRING "How many preferred decoders may be open at once, in all producers (empty or 0: no limit); the MLT_AVFORMAT_PREFER_MAX environment variable overrides it")
+if(MLT_AVFORMAT_PREFER_MAX_DEFAULT)
