From d9c8a6b59b568c8285fe1018f5a81efce3238e40 Mon Sep 17 00:00:00 2001
From: Andrew Youll <andrewyoull86@gmail.com>
Date: Wed, 21 Oct 2026 21:08:36 +0100
Subject: [PATCH 6/6] avformat producer: consumer.source_colours, the colours
 kept as they come

A frame asked with consumer.source_colours set (a preview whose display
shows either colour space, either range) gets its picture in the clip's
own colour space and range: a BT.709 clip in an SD profile was converted
to BT.601 through RGB, costing more than decoding it.
---
 src/modules/avformat/producer_avformat.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/src/modules/avformat/producer_avformat.c b/src/modules/avformat/producer_avformat.c
index b7a0cfe..95de9d1 100644
--- a/src/modules/avformat/producer_avformat.c
+++ b/src/modules/avformat/producer_avformat.c
@@ -2871,6 +2871,15 @@ static int producer_get_image(mlt_frame frame,
     int dst_full_range = (*format == mlt_image_none) ? self->full_range
                                                      : mlt_image_full_range(dst_color_range);
 
+    // A consumer that shows any colours as they come (a preview, which tells
+    // its display the frame's "colorspace" and "full_range"): none converted.
+    // A BT.709 HD clip in an SD profile was converted to BT.601 through RGB,
+    // costing more than decoding it.
+    if (*format != mlt_image_none && mlt_properties_get_int(frame_properties, "consumer.source_colours")) {
+        dst_colorspace = self->yuv_colorspace;
+        dst_full_range = self->full_range;
+    }
+
     mlt_service_lock(MLT_PRODUCER_SERVICE(producer));
     pthread_mutex_lock(&self->video_mutex);
     mlt_log_timings_begin();
