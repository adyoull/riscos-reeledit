Date: Thu, 29 Oct 2026 10:20:40 +0000
Subject: [PATCH 13/13] luma: yuv420p wipes (a luma map) without yuv422, a
 table of mixes and NEON rows

---
 src/modules/core/core_neon.c       | 23 +++++++
 src/modules/core/core_neon.h       |  4 ++
 src/modules/core/transition_luma.c | 97 ++++++++++++++++++++++++++++++
 3 files changed, 124 insertions(+)

diff --git a/src/modules/core/core_neon.c b/src/modules/core/core_neon.c
index b0b3a19..31c4eac 100644
--- a/src/modules/core/core_neon.c
+++ b/src/modules/core/core_neon.c
@@ -47,6 +47,23 @@ static inline int to8(int32_t v)
     return v < 0 ? 0 : v > 256 ? 256 : v;
 }
 
+int mlt_core_neon_mix_w(uint8_t *d, const uint8_t *s, const uint16_t *w, int n)
+{
+    if (!mlt_core_neon())
+        return 0;
+    int i = 0;
+    uint16x8_t full = vdupq_n_u16(256);
+    for (; i + 8 <= n; i += 8) {
+        uint16x8_t vw = vld1q_u16(w + i), vi = vsubq_u16(full, vw);
+        uint16x8_t sum = vmulq_u16(vmovl_u8(vld1_u8(s + i)), vw);
+        sum = vmlaq_u16(sum, vmovl_u8(vld1_u8(d + i)), vi);
+        vst1_u8(d + i, vshrn_n_u16(sum, 8));
+    }
+    for (; i < n; i++)
+        d[i] = (s[i] * w[i] + d[i] * (256 - w[i])) >> 8;
+    return 1;
+}
+
 int mlt_core_neon_mix(uint8_t *d, const uint8_t *s, int n, int32_t mix)
 {
     if (!mlt_core_neon())
@@ -179,6 +196,12 @@ int mlt_core_neon(void)
     return 0;
 }
 
+int mlt_core_neon_mix_w(uint8_t *d, const uint8_t *s, const uint16_t *w, int n)
+{
+    (void) d, (void) s, (void) w, (void) n;
+    return 0;
+}
