+                                              luma_bitmap,
+                                              mix,
+                                              luma_softness,
+                                              *width,
+                                              *height)) {
+            ret = 0;
         } else {
             *format = mlt_image_yuv422;
             luma_composite_yuv422(!invert ? a_frame : b_frame,
