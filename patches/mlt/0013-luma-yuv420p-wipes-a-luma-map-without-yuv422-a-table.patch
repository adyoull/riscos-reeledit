diff --git a/src/modules/core/transition_luma.c b/src/modules/core/transition_luma.c
index 7b46f06..713942d 100644
--- a/src/modules/core/transition_luma.c
+++ b/src/modules/core/transition_luma.c
@@ -510,6 +510,92 @@ static void luma_composite_yuv422(mlt_frame a_frame,
     }
 }
 
+/** A wipe of two opaque yuv420p progressive pictures by the luma map,
+ * plane by plane: each pixel's mix (the yuv422 path's integer smoothstep)
+ * looked up in a table made for this frame (the map's values in 1024
+ * steps), a row of weights at a time, and the two rows mixed by them
+ * (core_neon.h's mix_w: NEON where there is). It saves converting both
+ * pictures to yuv422 and back, and a smoothstep for every pixel. A chroma
+ * pixel takes the weight of the top-left luma pixel of its 2x2.
+ *
+ * \return 0 if it was done; non-zero (nothing changed) if a picture isn't
+ * yuv420p, isn't opaque, or the sizes differ: the yuv422 path then.
+ */
+
+static int luma_composite_yuv420p(mlt_frame a_frame,
+                                  mlt_frame b_frame,
+                                  int luma_width,
+                                  int luma_height,
+                                  uint16_t *luma_bitmap,
+                                  float pos,
+                                  float softness,
+                                  int width,
+                                  int height)
+{
+    mlt_image_format format = mlt_image_yuv420p;
+    int width_src = width, height_src = height;
+    uint8_t *p_dest = NULL, *p_src = NULL;
+    if ((width | height) & 1 || width < 2 || height < 2)
+        return 1;
+    if (mlt_frame_get_image(a_frame, &p_dest, &format, &width, &height, 1) || !p_dest
+        || format != mlt_image_yuv420p)
+        return 1;
+    format = mlt_image_yuv420p;
+    if (mlt_frame_get_image(b_frame, &p_src, &format, &width_src, &height_src, 0) || !p_src
+        || format != mlt_image_yuv420p || width_src != width || height_src != height)
+        return 1;
+    uint8_t *alpha_dst = mlt_frame_get_alpha(a_frame), *alpha_src = mlt_frame_get_alpha(b_frame);
+    if ((alpha_dst && !is_opaque(alpha_dst, width, height))
+        || (alpha_src && !is_opaque(alpha_src, width, height)))
+        return 1;
+    uint16_t *table = mlt_pool_alloc(1024 * sizeof(uint16_t));
+    uint16_t *w_row = mlt_pool_alloc(width * sizeof(uint16_t));
+    uint16_t *c_row = mlt_pool_alloc((width / 2) * sizeof(uint16_t));
+    if (!table || !w_row || !c_row) {
+        mlt_pool_release(table);
+        mlt_pool_release(w_row);
+        mlt_pool_release(c_row);
+        return 1;
+    }
+    uint32_t i_softness = softness * (1 << 16), field_pos = (1 << 16) * (pos * (1.f + softness));
+    for (int k = 0; k < 1024; k++) { /* (16.16 to 8.8: 0 .. 256) */
+        int32_t weight = (k << 6) + 32;
+        table[k] = (smoothstep(weight, i_softness + weight, field_pos) + 128) >> 8;
+    }
+    int32_t x_diff = (luma_width << 16) / width, y_diff = (luma_height << 16) / height;
+    int cw = width / 2, ch = height / 2;
+    uint8_t *du = p_dest + width * height, *dv = du + cw * ch;
+    const uint8_t *su = p_src + width * height, *sv = su + cw * ch;
+    for (int y = 0; y < height; y++) {
+        int ly = (int) (((int64_t) y * y_diff) >> 16);
+        const uint16_t *l = luma_bitmap + (ly < luma_height ? ly : luma_height - 1) * luma_width;
+        int32_t x_offset = 0;
+        for (int x = 0; x < width; x++, x_offset += x_diff)
+            w_row[x] = table[l[x_offset >> 16] >> 6];
+        uint8_t *d = p_dest + y * width;
+        const uint8_t *s = p_src + y * width;
+        if (!mlt_core_neon_mix_w(d, s, w_row, width))
+            for (int x = 0; x < width; x++)
+                d[x] = (s[x] * w_row[x] + d[x] * (256 - w_row[x])) >> 8;
+        if (y & 1)
+            continue;
+        for (int x = 0; x < cw; x++)
+            c_row[x] = w_row[2 * x];
+        int cy = y / 2;
+        for (int c = 0; c < 2; c++) {
+            uint8_t *dc = (c ? dv : du) + cy * cw;
+            const uint8_t *sc = (c ? sv : su) + cy * cw;
+            if (!mlt_core_neon_mix_w(dc, sc, c_row, cw))
+                for (int x = 0; x < cw; x++)
+                    dc[x] = (sc[x] * c_row[x] + dc[x] * (256 - c_row[x])) >> 8;
+        }
+    }
+    mlt_pool_release(table);
+    mlt_pool_release(w_row);
+    mlt_pool_release(c_row);
+    return 0;
+}
+
 static int luma_composite_rgba32(mlt_frame a_frame,
                                  mlt_frame b_frame,
                                  int luma_width,
@@ -1037,6 +1123,17 @@ static int transition_get_image(mlt_frame a_frame,
                                         *height,
                                         invert,
                                         alpha_over);
